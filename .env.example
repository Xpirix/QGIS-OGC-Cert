# Copy to .env and adjust. Every value has a default, so .env is optional.

# --- Service under test ------------------------------------------------------
# Which published QGIS Server image to certify: `ltr`, `stable`, or a pinned
# version such as `3.44` for a reproducible run.
QGIS_TAG=ltr

# QGIS Server log verbosity: 0=INFO (very chatty), 1=WARNING, 2=CRITICAL.
QGIS_SERVER_LOG_LEVEL=2

# Host port for the nginx front end exposing the suite endpoints. Bound to
# loopback by default; the public deployment puts Caddy in front instead.
HTTP_BIND=127.0.0.1
HTTP_PORT=8089

# Names the certification endpoints, mirroring the QGIS.org reference server:
#   /qgisserver_<slug>_teamengine
#   /certification_ogcapif_qgisserver_<slug>/wfs3/
# Use a real version (e.g. 3_44) when pinning QGIS_TAG to a release.
QGIS_VERSION_SLUG=ltr

# Per-IP limits on the OGC endpoints. Must stay well above what a TEAM Engine
# conformance run demands — at 10r/s it throttles the suite into mass failures.
OGC_RATE_LIMIT=100r/s
OGC_RATE_BURST=200
OGC_CONN_LIMIT=50

# The hostname QGIS Server advertises in the absolute URLs it generates, and
# which the TEAM Engine container uses to reach it. Must resolve on the
# `ogc-cert` network — the compose service name is the sane default. Changing
# it requires re-running `make bootstrap` so the WMS MetadataURLs match.
OGC_PUBLIC_HOST=nginx

# OGC API Features root path. QGIS 3.x serves it at /wfs3; QGIS 4 moved it to
# /ogcapi. Change this if QGIS_TAG points at a 4.x image.
OGCAPI_ROOT=/wfs3

# --- Test harness ------------------------------------------------------------
# Host port pyogctest publishes its TEAM Engine container on. Change it if 8081
# is already taken. The web UI is browsable there while a suite runs
# (login: ogctest / ogctest).
TE_PORT=8081

# Docker daemon socket, mounted into the runner so pyogctest can start TEAM
# Engine. Auto-detected from the active docker context — rootful Docker uses
# /var/run/docker.sock, rootless /run/user/<uid>/docker.sock. Set only to
# override that detection.
#DOCKER_SOCK=/var/run/docker.sock

# NOTE: ETS image versions are not configurable here. pyogctest pins them
# (ogccite/ets-wms13, ogccite/ets-ogcapi-features10:1.0-teamengine-5.4) so that
# results match the suites QGIS is formally certified against.
