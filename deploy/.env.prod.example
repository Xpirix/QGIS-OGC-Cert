# Production configuration. Copy to the repository root as .env and edit.
#
#   cp deploy/.env.prod.example .env

# --- Public identity ---------------------------------------------------------
# The domain, with DNS A/AAAA records already pointing at this host. Caddy
# obtains a Let's Encrypt certificate for it on first start.
SITE_ADDRESS=ogc.example.org
ACME_EMAIL=you@example.org

# The hostname QGIS Server advertises in the URLs it generates. Must match
# SITE_ADDRESS in production. Changing it requires re-running bootstrap so the
# WMS MetadataURLs are rewritten to match.
OGC_PUBLIC_HOST=ogc.example.org

# Scheme the WMS MetadataURLs are published with. Must be https on a TLS
# deployment: the WMS 1.3.0 suite dereferences these, and http:// entries in an
# otherwise-https capabilities document only resolve via a redirect — which
# fails outright if port 80 is closed.
OGC_PUBLIC_SCHEME=https

# Leave empty in production. Set to "tls internal" for a local dry-run using
# Caddy's own CA — no DNS or public reachability required.
CADDY_TLS=

# --- Service under test ------------------------------------------------------
# Pin to the exact release being certified rather than a moving tag.
QGIS_TAG=3.44

# Names the certification endpoints, mirroring the QGIS.org convention:
#   /qgisserver_3_44_teamengine
#   /certification_ogcapif_qgisserver_3_44/wfs3/
QGIS_VERSION_SLUG=3_44

# QGIS 3.x serves OGC API Features at /wfs3; QGIS 4 moved it to /ogcapi.
OGCAPI_ROOT=/wfs3

# --- Limits ------------------------------------------------------------------
# Caddy owns 80/443; nginx must not be reachable directly. Loopback-only.
HTTP_BIND=127.0.0.1
HTTP_PORT=8089

# Must stay well above what a TEAM Engine conformance run demands — throttling
# one is the difference between 185 tests passing and 91. Raise, never lower,
# unless you have measured a real run against the new value.
OGC_RATE_LIMIT=100r/s
OGC_RATE_BURST=200
OGC_CONN_LIMIT=50

# QGIS render limits. Both default to unlimited (-1) upstream, which is a DoS
# vector on a public server.
QGIS_SERVER_WMS_MAX_WIDTH=4096
QGIS_SERVER_WMS_MAX_HEIGHT=4096
QGIS_SERVER_API_WFS3_MAX_LIMIT=1000

# 0=INFO, 1=WARNING, 2=CRITICAL
QGIS_SERVER_LOG_LEVEL=1
